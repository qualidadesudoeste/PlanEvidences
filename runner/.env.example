# URL exata usada pelo QA para abrir o PlanEvidences.
PLAN_EVIDENCES_URL=http://136.248.115.65:4500

# Runner escuta somente no computador local.
RUNNER_PORT=4317

# true executa o navegador em segundo plano, sem abrir uma janela de teste.
RUNNER_HEADLESS=true

# Máximo de decisões da IA por cenário.
RUNNER_MAX_STEPS=35

# Tempo máximo para aguardar barras de carregamento e a estabilização da tela.
RUNNER_UI_SETTLE_TIMEOUT_MS=90000
