# URL exata usada pelo QA para abrir o PlanEvidences.
PLAN_EVIDENCES_URL=http://localhost:4500

# Runner escuta somente no computador local.
RUNNER_PORT=4317

# false abre o navegador para o QA acompanhar a execução.
RUNNER_HEADLESS=false

# Máximo de decisões da IA por cenário.
RUNNER_MAX_STEPS=35
